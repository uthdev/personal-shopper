{
  "name": "personal-shopper",
  "version": "1.0.0",
  "description": "E-commerce microservices platform",
  "private": true,
  "scripts": {
    "install:all": "pnpm install",
    "dev:customer": "pnpm --filter customer-service dev",
    "dev:product": "pnpm --filter product-service dev",
    "dev:order": "pnpm --filter order-service dev",
    "dev:payment": "pnpm --filter payment-service dev",
    "dev:worker": "pnpm --filter worker-service dev",
    "dev:all": "concurrently \"pnpm dev:customer\" \"pnpm dev:product\" \"pnpm dev:order\" \"pnpm dev:payment\" \"pnpm dev:worker\"",
    "build:all": "pnpm -r build",
    "start:all": "pnpm -r start",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker-compose down -v --remove-orphans",
    "docker:dev:up": "docker-compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker-compose -f docker-compose.dev.yml down",
    "docker:dev:clean": "docker-compose -f docker-compose.dev.yml down -v --remove-orphans",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:all": "pnpm -r test"
  },
  "devDependencies": {
    "@types/node": "^20.5.0",
    "typescript": "^5.1.6",
    "ts-node": "^10.9.1",
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.0",
    "zod": "^3.22.2",
    "winston": "^3.10.0",
    "morgan": "^1.10.0",
    "@types/morgan": "^1.9.4",
    "jest": "^29.6.2",
    "@types/jest": "^29.5.4",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.12",
    "mongodb-memory-server": "^8.15.1"
  }
}